# Perfil de AWS a usar (el mismo con el que hiciste `aws configure`)
AWS_PROFILE=profile

# Región donde tienes habilitado el acceso a los modelos de Bedrock
AWS_REGION=eu-west-1

# Opcional — ID del modelo/perfil de inferencia de Bedrock (por defecto: eu.amazon.nova-micro-v1:0)
# BEDROCK_MODEL_ID=eu.amazon.nova-micro-v1:0

# Recursos creados por Terraform (infra/) — ver `terraform output` en infra/ tras el apply
DYNAMODB_TABLE=
LRC_BUCKET=
